{
  "name": "groupme-cli",
  "version": "1.0.4",
  "description": "Command-line interface for GroupMe messaging",
  "main": "dist/index.js",
  "bin": {
    "groupme": "./dist/groupme-cli.js"
  },
  "scripts": {
    "build": "tsc",
    "bundle": "esbuild src/index.ts --bundle --platform=node --target=node16 --outfile=dist/groupme-cli.js --external:groupme && chmod +x dist/groupme-cli.js",
    "start": "node dist/groupme-cli.js",
    "dev": "tsc --watch",
    "prepublishOnly": "npm run bundle"
  },
  "keywords": [
    "groupme",
    "cli",
    "messaging",
    "chat"
  ],
  "author": "cuuush",
  "license": "MIT",
  "type": "commonjs",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=16.0.0"
  },
  "dependencies": {
    "commander": "^14.0.3",
    "groupme": "^0.5.8"
  },
  "devDependencies": {
    "@types/node": "^25.2.0",
    "esbuild": "^0.27.3",
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/cuuush/groupme-cli.git"
  },
  "homepage": "https://github.com/cuuush/groupme-cli",
  "bugs": {
    "url": "https://github.com/cuuush/groupme-cli/issues"
  }
}
